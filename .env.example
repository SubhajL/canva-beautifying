# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Cloudflare R2 (or S3-compatible)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_cloudflare_access_key
CLOUDFLARE_SECRET_ACCESS_KEY=your_cloudflare_secret_key

# Bucket name (new env first, legacy fallback supported)
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=your_r2_public_url

# Optional: Override endpoint/region for local S3-compatible (e.g., MinIO)
# R2_ENDPOINT=http://127.0.0.1:9000
# R2_REGION=us-east-1
# R2_FORCE_PATH_STYLE=true
# Force TLS 1.2 for corporate proxies/SSL inspection
# R2_TLS12=true

# Proxy support (if your network requires it)
# HTTPS_PROXY=http://your.proxy:port
# HTTP_PROXY=http://your.proxy:port
# NO_PROXY=localhost,127.0.0.1

# Trust a corporate CA performing SSL interception
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem

# E2E-only toggles (non-production)
# E2E_TEST_MODE=true
# E2E_STORAGE_FAKE_DOWNLOAD=true

# Redis
REDIS_URL=redis://localhost:6379

# AI Models
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_FALLBACK=your_gemini_fallback_key_optional
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_KEY_FALLBACK=your_openai_fallback_key_optional
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_API_KEY_FALLBACK=your_anthropic_fallback_key_optional
REPLICATE_API_KEY=your_replicate_api_key
REPLICATE_API_KEY_FALLBACK=your_replicate_fallback_key_optional

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:5001

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Canva Beautify

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# Monitoring & Observability
LOG_LEVEL=info
ENABLE_METRICS_ENDPOINT=true
METRICS_AUTH_TOKEN=your-secret-metrics-token

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret

# Payment Processing (Future)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
